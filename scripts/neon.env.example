# Copy to ~/.config/pageblink/neon.env (outside the repo) and fill in. Never commit the real file.
# The database password is NOT here: it is read from
# app/pageblink_server/config/passwords.yaml -> staging: database:
export SERVERPOD_DATABASE_HOST=<your-neon-host>.neon.tech
export SERVERPOD_DATABASE_PORT=5432
export SERVERPOD_DATABASE_NAME=<db-name>
export SERVERPOD_DATABASE_USER=<db-user>
export SERVERPOD_DATABASE_REQUIRE_SSL=true
